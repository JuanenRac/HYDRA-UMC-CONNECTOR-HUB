{
  "adapterId": "industrial-opcua",
  "schemaVersion": "1.0",
  "protocol": "opc-ua",
  "targetKinds": ["plc", "cnc-controller", "scada"],
  "endpointSchema": {
    "type": "object",
    "properties": {
      "endpointUrl": { "type": "string", "pattern": "^opc\\.tcp://" },
      "securityPolicy": { "type": "string" }
    },
    "required": ["endpointUrl"]
  },
  "authenticationRef": "none:anonymous-read",
  "capabilities": [
    {
      "name": "readNodeValue",
      "mode": "read",
      "risk": "low"
    }
  ],
  "requiredSafetyGates": [],
  "healthCheck": { "type": "opcua-read", "node": "ns=0;i=2259" },
  "timeoutMs": 3000,
  "idempotency": "idempotent",
  "evidenceSchema": {
    "type": "object",
    "properties": { "nodeId": { "type": "string" }, "value": {}, "sourceTimestamp": { "type": "string" } }
  },
  "sdkCompatibility": ">=0.1.0",
  "ownerProject": "HYDRA-UMC-OPCUA-SERVER"
}
